# Target Twitch channel
TWITCH_CHANNEL=ishowspeed

# Video Quality preferences
PREFERRED_QUALITY=720p,720p60,best

# Warmup duration in seconds before trigger evaluation (default: 300 = 5 minutes)
WARMUP_DURATION_SEC=300

# Cooldown between clips in seconds (default: 120 = 2 minutes)
COOLDOWN_SEC=120

# Trigger thresholds
CHAT_SPIKE_MULTIPLIER=3.0
AUDIO_SPIKE_DB=6.0

